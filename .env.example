# Copy to .env and adjust. start.sh and docker compose read these.
ANTHROPIC_API_KEY=            # leave empty for rule-based suggestions only
AI_PROVIDER=auto              # auto | anthropic | cli (development only) | off
AI_ALLOW_CLI=0                # set to 1 to allow the development CLI with DJANGO_DEBUG=0
AI_MODEL=claude-opus-5-5      # Claude model used with AI_PROVIDER=anthropic
WORKFLOW_BACKEND=temporal     # temporal | local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# DJANGO_SECURE_COOKIES=1    # enable when serving the app over HTTPS

# Set POSTGRES_HOST to use PostgreSQL for the local launcher.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=h02_payroll_compliance
# POSTGRES_USER=your_local_role
# POSTGRES_PASSWORD=

# HR_TOOL_PROFILES=0 ignores integrations/*/profile.json, so even Horilla is read as an unknown tool (AI finds screens and suggests the mapping)
# HR_TOOL_PROFILES=1
